<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CarPlay audio app. Apple grants this per developer account on request;
	     a provisioning profile without it means Liner never shows up in CarPlay
	     (the phone app and CarPlay's Now Playing screen still work). -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
